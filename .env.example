# RDVS.studio - root environment variables
# Copy to .env and fill in. This file is the ONLY place a Sanity token is read from, and the only
# thing that reads it is scripts/sync_project_status.py (Sanity <-> data/project-status.json).
# The website itself needs none of this: js/sanity-client.js queries the public CDN with no token,
# and the Studio keeps its own copy in studio/.env.local (see studio/.env.example).

# Used by scripts/sync_project_status.py
# Never commit .env - it is in .gitignore. A real token is not a secret you can leave in Dropbox.
SANITY_PROJECT_ID=your_project_id_here
SANITY_DATASET=production

# Create at sanity.io/manage -> API -> Tokens. Read is enough for --pull; --push needs edit scope.
# The script refuses to run while this still reads "your_...".
SANITY_API_TOKEN=your_read_token_here

# Optional
# SANITY_API_VERSION=2024-01-01
# A reminder only, not checked: what the token above is actually allowed to do.
# SANITY_TOKEN_SCOPES=view

