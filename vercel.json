{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/:path", "destination": "/:path.html" }
  ],
  "routes": [
    { "src": "^/scripts/.*$", "status": 404 },
    { "src": "^/studio/.*$", "status": 404 },
    { "src": "^/scratch/.*$", "status": 404 },
    { "src": "^/data/project-status\\.json$", "status": 404 },
    { "src": "^/SANITY-SETUP\\.md$", "status": 404 },
    { "src": "^/[^/]+\\.py$", "status": 404 }
  ]
}
