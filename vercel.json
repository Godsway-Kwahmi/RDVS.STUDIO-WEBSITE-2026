{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/:path", "destination": "/:path.html" }
  ],
  "routes": [
    { "src": "^/scripts/.*$", "status": 404 },
    { "src": "^/studio/.*$", "status": 404 },
    { "src": "^/scratch/.*$", "status": 404 },
    { "src": "^/SANITY-SETUP\\.md$", "status": 404 },
    { "src": "^/[^/]+\\.py$", "status": 404 }
  ]
}
