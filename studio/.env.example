# Sanity Studio local environment — copy to studio/.env.local and fill in.
#
# The Studio reads SANITY_STUDIO_* at config time (studio/sanity.config.ts). Both values already
# default to the live project, so `sanity dev` runs from a fresh clone WITHOUT this file; it exists
# so a second machine or a staging dataset can be pointed at without editing tracked config.
#
# Do not commit studio/.env.local. It is in .gitignore, along with studio/.env and both root files.

# Optional — the Sanity project id. Currently lqnpv8ns (studio/sanity.cli.ts carries the same one).
SANITY_STUDIO_PROJECT_ID=lqnpv8ns

# Optional — the dataset to edit. Almost always "production".
SANITY_STUDIO_DATASET=production

# Optional — only needed by scripts that write to the dataset from outside the Studio
# (sanity dataset import, the visibility sync in scripts/sync_project_status.py).
# Create one at sanity.io/manage -> API -> Tokens, with at least "Editor" rights.
# The public site needs NO token: js/sanity-client.js queries the CDN over unauthenticated
# GETs, which works because the dataset is public. Never put a write token in a file the
# browser can read.
SANITY_API_TOKEN=
