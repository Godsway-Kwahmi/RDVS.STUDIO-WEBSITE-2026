{
  "compilerOptions": {
    "target": "ES2017",
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "lib": ["dom", "ES2017"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
